    def is_dotnet(self) -> bool: ...
    def virtual_address_to_relative_virtual_address(
        self, virtual_address: int
    ) -> int: ...
    def virtual_address_to_file_offset(self, virtual_address: int) -> int | None: ...
    def relative_virtual_address_to_file_offset(
        self, relative_virtual_address: int
    ) -> int | None: ...
    def relative_virtual_address_to_virtual_address(
        self, relative_virtual_address: int
    ) -> int: ...
    def file_offset_to_relative_virtual_address(
        self, file_offset: int
    ) -> int | None: ...
    def file_offset_to_virtual_address(self, file_offset: int) -> int | None: ...
    def architecture(self) -> Architecture: ...
    def dotnet_metadata_token_virtual_addresses(self) -> dict[int, int]: ...
    def dotnet_metadata_token_to_virtual_address(
        self, metadata_token: int
    ) -> int | None: ...
    def dotnet_metadata_token_to_relative_virtual_address(
        self, metadata_token: int
    ) -> int | None: ...
    def dotnet_metadata_token_to_file_offset(
        self, metadata_token: int
    ) -> int | None: ...
    def dotnet_virtual_address_to_metadata_token(
        self, virtual_address: int
    ) -> int | None: ...
    def dotnet_relative_virtual_address_to_metadata_token(
        self, relative_virtual_address: int
    ) -> int | None: ...
    def dotnet_file_offset_to_metadata_token(self, file_offset: int) -> int | None: ...
    def dotnet_executable_virtual_address_ranges(self) -> dict[int, int]: ...
    def executable_virtual_address_ranges(self) -> dict[int, int]: ...
    def bytes(self) -> bytes: ...
    def symbols(self) -> list[Symbol]: ...
    def metadata(self) -> dict[str, object]: ...
    def virtual_address_to_symbol(self, virtual_address: int) -> Symbol | None: ...
    def symbol_name_to_virtual_address(self, name: str) -> int | None: ...
